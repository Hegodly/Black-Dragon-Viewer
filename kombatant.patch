+            hadDLSS=ok && (frame.executed&1);previousMode=mode;previousWidth=w;previousHeight=h;
+            previousVP=vp;previousCamera=camera;previousForward=forward;previousJitterX=jx;previousJitterY=jy;lastFrame=now;
+            if(!ok)
+            {
+                // Stop failed DLSS requests so the next frame removes temporal jitter and restores normal resolution.
+                if(mode) gSavedSettings.setU32("KombatantDLSSMode",0);
+                if(ray) gSavedSettings.setBOOL("KombatantRayAO",false);
+                return source;
+            }
+            if(mode && !(frame.executed&1)) gSavedSettings.setU32("KombatantDLSSMode",0);
+            if(ray && !(frame.executed&2) && !geometry.empty()) gSavedSettings.setBOOL("KombatantRayAO",false);
