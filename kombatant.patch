diff --git a/indra/newview/kombatantstudio.h b/indra/newview/kombatantstudio.h
new file mode 100644
index 0000000..4ecbd85
--- /dev/null
+++ b/indra/newview/kombatantstudio.h
@@ -0,0 +1,93 @@
+/**
+ * Kombatant Viewer Studio. Derived from Black Dragon / Second Life Viewer.
+ * New code Copyright (C) 2026 Kombatant Viewer contributors.
+ * SPDX-License-Identifier: LGPL-2.1-only
+ */
+#ifndef KOMBATANT_STUDIO_H
+#define KOMBATANT_STUDIO_H
+
+#include "llfloater.h"
+#include "llbutton.h"
+#include "lltextbox.h"
+#include "llviewercontrol.h"
+#include "pipeline.h"
+
+// Header implementation is included by llviewerfloaterreg.cpp only.
+class KombatantStudio final : public LLFloater
+{
+public:
+    explicit KombatantStudio(const LLSD& key) : LLFloater(key) {}
+
+    bool postBuild() override
+    {
+        getChild<LLButton>("everyday")->setClickedCallback([this]() { applyMode(0); });
+        getChild<LLButton>("cinematic")->setClickedCallback([this]() { applyMode(1); });
+        getChild<LLButton>("crowded")->setClickedCallback([this]() { applyMode(2); });
+        getChild<LLButton>("restore")->setClickedCallback([this]() { restore(); });
+        getChild<LLButton>("restore")->setEnabled(false);
+        return true;
+    }
+
+    void draw() override
+    {
+        const auto& target = gPipeline.mMainRT.screen;
+        getChild<LLTextBox>("live_size")->setText("Actual world buffer: " +
+            std::to_string(target.getWidth()) + " x " + std::to_string(target.getHeight()));
+        LLFloater::draw();
+    }
+
+private:
+    LLSD mSaved;
+
+    void put(const std::string& name, const LLSD& value)
+    {
+        auto control = gSavedSettings.getControl(name);
+        if (!control) return;
+        // Keep the original value across repeated switches in this session.
+        if (!mSaved.has(name)) mSaved[name] = control->getValue();
+        control->setValue(value);
+    }
+
+    void applyMode(int mode)
+    {
+        const bool cinema = mode == 1;
+        const bool crowded = mode == 2;
+        put("RenderFarClip", LLSD(crowded ? 64.0 : cinema ? 128.0 : 96.0));
+        put("RenderShadowDetail", LLSD(crowded ? 0 : cinema ? 2 : 1));
+        put("RenderShadowResolutionScale", LLSD(cinema ? 1.0 : 0.75));
+        put("RenderDeferredSSAO", LLSD(!crowded));
+        put("RenderReflectionProbeDetail", LLSD(cinema ? 1 : 0));
+        put("RenderAvatarMaxNonImpostors", LLSD(crowded ? 4 : cinema ? 12 : 8));
+        put("RenderAvatarMaxComplexity", LLSD(crowded ? 100000 : cinema ? 250000 : 150000));
+        put("RenderResolutionDivisor", LLSD(1));
+        put("RenderGlow", LLSD(!crowded));
+        put("RenderGlowStrength", LLSD(cinema ? 0.12 : 0.05));
+        put("RenderTonemapType", LLSD(0)); // Existing Khronos Neutral mapper.
+        put("RenderTonemapMix", LLSD(1.0));
+        put("RenderChromaStrength", LLSD(0.0));
+        put("RenderDepthOfField", LLSD(false)); // Focus blur remains opt-in.
+        LLSD vignette = LLSD::emptyArray();
+        vignette.append(cinema ? 0.12 : 0.0);
+        vignette.append(1.0);
+        vignette.append(3.0);
+        put("ExodusRenderVignette", vignette);
+        getChild<LLButton>("restore")->setEnabled(true);
+        getChild<LLTextBox>("status")->setText(LLStringExplicit(cinema ?
+            "Cinematic active: shadows, ambient occlusion and subtle bloom." : crowded ?
+            "Crowded Area active: shorter view and fewer full-detail avatars." :
+            "Everyday active: balanced lighting and shorter draw distance."));
+    }
+
+    void restore()
+    {
+        for (LLSD::map_const_iterator it = mSaved.beginMap(); it != mSaved.endMap(); ++it)
+        {
+            auto control = gSavedSettings.getControl(it->first);
+            if (control) control->setValue(it->second);
+        }
+        mSaved = LLSD();
+        getChild<LLButton>("restore")->setEnabled(false);
+        getChild<LLTextBox>("status")->setText(LLStringExplicit("Your previous graphics settings have been restored."));
+    }
+};
+#endif
