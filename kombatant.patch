+        if(!file || file.tellg()<=0 || file.tellg()>1024*1024) throw std::runtime_error("Missing/invalid ray AO shader");
+        std::vector<char> binary(static_cast<size_t>(file.tellg()));file.seekg(0);file.read(binary.data(),binary.size());
+        if(!file) throw std::runtime_error("Cannot read ray AO shader");
