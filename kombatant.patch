+        }
+        catch(const std::exception& ex)
+        {
+            status(std::string("RTX transfer failed: ")+ex.what());
+            gSavedSettings.setU32("KombatantDLSSMode",0);gSavedSettings.setBOOL("KombatantRayAO",false);return source;
+        }
+    }
