+        srv={};srv.ViewDimension=D3D12_SRV_DIMENSION_TEXTURE2D;srv.Shader4ComponentMapping=D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;srv.Texture2D.MipLevels=1;
+        srv.Format=DXGI_FORMAT_R32_FLOAT;device->CreateShaderResourceView(depth.gpu.Get(),&srv,cpu);cpu.ptr+=descriptorSize;
+        srv.Format=DXGI_FORMAT_R32G32B32A32_FLOAT;device->CreateShaderResourceView(color.gpu.Get(),&srv,cpu);cpu.ptr+=descriptorSize;
+        D3D12_UNORDERED_ACCESS_VIEW_DESC uav{};uav.ViewDimension=D3D12_UAV_DIMENSION_TEXTURE2D;uav.Format=DXGI_FORMAT_R32G32B32A32_FLOAT;
