+cmake_minimum_required(VERSION 3.20)
+project(KombatantRTX LANGUAGES CXX)
+if(NOT WIN32 OR NOT MSVC)
+  message(FATAL_ERROR "KombatantRTX currently requires Windows x64/MSVC")
+endif()
+if(NOT EXISTS "${NGX_ROOT}/include/nvsdk_ngx.h" OR NOT EXISTS "${DXC_EXECUTABLE}")
+  message(FATAL_ERROR "Set NGX_ROOT to the pinned DLSS SDK and DXC_EXECUTABLE to dxc.exe")
+endif()
+add_custom_command(OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/kombatant_rtao.dxil"
+  COMMAND "${DXC_EXECUTABLE}" -T cs_6_5 -E main -WX -O3 -Fo "${CMAKE_CURRENT_BINARY_DIR}/kombatant_rtao.dxil" "${CMAKE_CURRENT_SOURCE_DIR}/ray_ao.hlsl"
+  DEPENDS ray_ao.hlsl VERBATIM)
+add_custom_target(ray_ao_shader ALL DEPENDS "${CMAKE_CURRENT_BINARY_DIR}/kombatant_rtao.dxil")
+add_library(KombatantRTX64 SHARED rtx_backend.cpp)
+target_compile_features(KombatantRTX64 PRIVATE cxx_std_17)
+target_compile_definitions(KombatantRTX64 PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
+target_compile_options(KombatantRTX64 PRIVATE /W4 /EHsc)
+set_property(TARGET KombatantRTX64 PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded")
+target_include_directories(KombatantRTX64 PRIVATE "${NGX_ROOT}/include")
+target_link_libraries(KombatantRTX64 PRIVATE d3d12 dxgi dxguid shell32 ole32 shlwapi "${NGX_ROOT}/lib/Windows_x86_64/x64/nvsdk_ngx_s.lib")
+add_dependencies(KombatantRTX64 ray_ao_shader)
+install(TARGETS KombatantRTX64 RUNTIME DESTINATION .)
+install(FILES "${CMAKE_CURRENT_BINARY_DIR}/kombatant_rtao.dxil" "${NGX_ROOT}/lib/Windows_x86_64/rel/nvngx_dlss.dll" DESTINATION .)
+install(FILES "${NGX_ROOT}/LICENSE.txt" DESTINATION licenses RENAME NVIDIA-DLSS-LICENSE.txt)
+
+enable_testing()
+add_executable(rtx_math_test rtx_math_test.cpp)
+target_compile_features(rtx_math_test PRIVATE cxx_std_17)
+target_compile_options(rtx_math_test PRIVATE /UNDEBUG)
+add_test(NAME rtx_frame_and_motion COMMAND rtx_math_test)
+add_executable(rtx_smoke_test rtx_smoke_test.cpp)
+target_compile_features(rtx_smoke_test PRIVATE cxx_std_17)
+target_compile_definitions(rtx_smoke_test PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
+target_compile_options(rtx_smoke_test PRIVATE /UNDEBUG)
+add_test(NAME rtx_dll_failure_fallback COMMAND rtx_smoke_test "$<TARGET_FILE:KombatantRTX64>")
