+// Resolve the main world target once. Auxiliary probes and explicit snapshot
+// dimensions keep their own sizes. A zero target preserves upstream scaling.
+static void kombatantScreenSize(U32& width, U32& height, bool main_target)
+{
+    const U32 target = gSavedSettings.getU32("KombatantRenderWidth");
+    if (target && main_target && !gCubeSnapshot &&
+        width == gViewerWindow->getWorldViewWidthRaw() &&
+        height == gViewerWindow->getWorldViewHeightRaw() && width && height)
+    {
+        const U32 out_height = llmax(1U, (U32)((F64)target * height / width + 0.5));
+        GLint texture_limit = 0, renderbuffer_limit = 0;
+        glGetIntegerv(GL_MAX_TEXTURE_SIZE, &texture_limit);
+        glGetIntegerv(GL_MAX_RENDERBUFFER_SIZE, &renderbuffer_limit);
+        GLint viewport_limit[2] = {0, 0};
+        glGetIntegerv(GL_MAX_VIEWPORT_DIMS, viewport_limit);
+        const U32 limit = (U32)llmax(0, llmin(llmin(texture_limit, renderbuffer_limit),
+                                                        gGLManager.mGLMaxTextureSize));
+        if (target <= 12288 && target <= limit && out_height <= limit &&
+            target <= (U32)llmax(0, viewport_limit[0]) &&
+            out_height <= (U32)llmax(0, viewport_limit[1]))
+        {
+            width = target;
+            height = out_height;
+            return;
+        }
+        LL_WARNS() << "Kombatant live render size exceeds GPU limits; using window resolution." << LL_ENDL;
+        gSavedSettings.setU32("KombatantRenderWidth", 0);
+        width = gViewerWindow->getWorldViewWidthRaw();
+        height = gViewerWindow->getWorldViewHeightRaw();
+        return;
+    }
+    const U32 divisor = LLPipeline::RenderResolutionDivisor;
+    if (divisor > 1 && divisor < width && divisor < height)
+    {
+        width /= divisor;
+        height /= divisor;
+    }
+    else if (LLPipeline::RenderResolutionMultiplier != 1.f)
+    {
+        width = llmax(1U, (U32)(width * LLPipeline::RenderResolutionMultiplier));
+        height = llmax(1U, (U32)(height * LLPipeline::RenderResolutionMultiplier));
+    }
+}
