+++ b/kombatant/rtx/rtx_api.h
@@ -0,0 +1,23 @@
+// Copyright (C) 2026 Kombatant Viewer contributors
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <stdint.h>
+#define KOMBATANT_RTX_ABI 1u
+// ABI uses caller-owned, tightly packed float arrays. Rows are top-to-bottom.
+// This experimental CPU bridge deliberately avoids sharing graphics ownership.
+struct KombatantRtxFrame
+{
+    uint32_t abi, bytes, width, height, target_width, target_height;
+    uint32_t dlss_mode; // 0 off, 1 quality, 2 balanced, 3 performance
+    uint32_t ray_ao, reset, frame_index;
+    float jitter_x, jitter_y, frame_ms, ao_radius, ao_strength;
+    float inverse_view_projection[16]; // column-major, OpenGL NDC depth -1..1
+    const float* color;  // RGBA32F, display-referred (not HDR)
+    const float* depth;  // R32F, OpenGL depth 0..1, near=0
+    const float* motion; // RG32F, previous minus current, pixels (y down)
+    const float* vertices; // non-indexed world-space triangle XYZ positions
+    uint32_t vertex_count, geometry_revision;
+    float* output; // caller capacity >= target_width*target_height*4 floats
+    uint32_t output_width, output_height, executed; // bit 0 DLSS, bit 1 DXR AO
+};
+typedef int (*KombatantRtxProcess)(KombatantRtxFrame*, char*, uint32_t);
diff --git a/kombatant/rtx/rtx_backend.cpp b/kombatant/rtx/rtx_backend.cpp
new file mode 100644
--- /dev/null
+++ b/kombatant/rtx/rtx_backend.cpp
@@ -0,0 +1,361 @@
+// Copyright (C) 2026 Kombatant Viewer contributors
+// SPDX-License-Identifier: MIT
+// Experimental D3D12 compute module. Graphics ownership is confined to this DLL.
+#include "rtx_api.h"
+#include "rtx_math.h"
+#include <windows.h>
+#include <d3d12.h>
+#include <dxgi1_6.h>
+#include <wrl/client.h>
+#include <shlobj.h>
+#include <filesystem>
+#include <fstream>
+#include <vector>
+#include <array>
+#include <string>
+#include <stdexcept>
+#include <sstream>
+#include <cstring>
+#include <mutex>
+#include <algorithm>
+#include "nvsdk_ngx.h"
+#include "nvsdk_ngx_helpers.h"
+using Microsoft::WRL::ComPtr;
+namespace {
+void check(HRESULT hr, const char* operation)
+{
+    if (FAILED(hr)) { std::ostringstream s; s<<operation<<" failed (0x"<<std::hex<<uint32_t(hr)<<")"; throw std::runtime_error(s.str()); }
+}
+void ngxCheck(NVSDK_NGX_Result result, const char* operation)
+{
+    if (NVSDK_NGX_FAILED(result)) { std::ostringstream s; s<<operation<<" failed (NGX 0x"<<std::hex<<uint32_t(result)<<")"; throw std::runtime_error(s.str()); }
+}
+struct Texture {
+    ComPtr<ID3D12Resource> gpu, upload, readback;
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint{};
+    uint64_t bytes=0;
+    uint32_t width=0, height=0, channels=0;
+    D3D12_RESOURCE_STATES state=D3D12_RESOURCE_STATE_COPY_DEST;
+};
+class Runtime {
+    ComPtr<ID3D12Device5> device;
+    ComPtr<ID3D12CommandQueue> queue;
+    ComPtr<ID3D12CommandAllocator> allocator;
+    ComPtr<ID3D12GraphicsCommandList4> commands;
+    ComPtr<ID3D12Fence> fence;
+    HANDLE eventHandle=nullptr;
+    uint64_t serial=0;
+    bool initialized=false, dead=false, ngxInitialized=false, dlssAvailable=false, rayAvailable=false;
+    NVSDK_NGX_Parameter* parameters=nullptr;
+    NVSDK_NGX_Handle* dlss=nullptr;
+    uint32_t mode=0, iw=0, ih=0, ow=0, oh=0, geometryRevision=~0u;
+    Texture color, depth, motion, rayColor, upscaled;
+    ComPtr<ID3D12Resource> vertices, instances, blas, tlas, scratch;
+    ComPtr<ID3D12RootSignature> rayRoot;
+    ComPtr<ID3D12PipelineState> rayPipeline;
+    ComPtr<ID3D12DescriptorHeap> descriptors;
+    uint32_t descriptorSize=0;
+    std::filesystem::path modulePath;
+    std::string dlssDiagnostic="DLSS not requested", rayDiagnostic="DXR not requested";
+    std::string adapterName;
+
+    ComPtr<ID3D12Resource> buffer(uint64_t size, D3D12_HEAP_TYPE heap, D3D12_RESOURCE_STATES state,
+                                 D3D12_RESOURCE_FLAGS flags=D3D12_RESOURCE_FLAG_NONE)
+    {
+        D3D12_HEAP_PROPERTIES hp{}; hp.Type=heap;
+        D3D12_RESOURCE_DESC desc{};
+        desc.Dimension=D3D12_RESOURCE_DIMENSION_BUFFER; desc.Width=std::max<uint64_t>(size,256);
+        desc.Height=1; desc.DepthOrArraySize=1; desc.MipLevels=1;
+        desc.SampleDesc.Count=1; desc.Layout=D3D12_TEXTURE_LAYOUT_ROW_MAJOR; desc.Flags=flags;
+        ComPtr<ID3D12Resource> result;
+        check(device->CreateCommittedResource(&hp,D3D12_HEAP_FLAG_NONE,&desc,state,nullptr,IID_PPV_ARGS(&result)),"Create buffer");
+        return result;
+    }
+    void uploadBuffer(ID3D12Resource* target, const void* data, size_t bytes)
+    {
+        void* p=nullptr; D3D12_RANGE read{0,0}; check(target->Map(0,&read,&p),"Map upload");
+        std::memcpy(p,data,bytes); target->Unmap(0,nullptr);
+    }
+    void begin()
+    {
+        check(allocator->Reset(),"Reset allocator");
+        check(commands->Reset(allocator.Get(),nullptr),"Reset command list");
+    }
+    void submit()
+    {
+        check(commands->Close(),"Close command list");
+        ID3D12CommandList* lists[]={commands.Get()}; queue->ExecuteCommandLists(1,lists);
+        check(queue->Signal(fence.Get(),++serial),"Signal fence");
+        if(fence->GetCompletedValue()<serial)
+        {
+            check(fence->SetEventOnCompletion(serial,eventHandle),"Fence event");
+            if(WaitForSingleObject(eventHandle,10000)!=WAIT_OBJECT_0)
+                throw std::runtime_error("D3D12 GPU wait timed out; RTX disabled until restart");
+        }
+        check(device->GetDeviceRemovedReason(),"D3D12 device");
+    }
+    void barrier(ID3D12Resource* resource)
+    {
+        D3D12_RESOURCE_BARRIER b{}; b.Type=D3D12_RESOURCE_BARRIER_TYPE_UAV; b.UAV.pResource=resource;
+        commands->ResourceBarrier(1,&b);
+    }
+    void transition(Texture& tex, D3D12_RESOURCE_STATES state)
+    {
+        if(tex.state==state) return;
+        D3D12_RESOURCE_BARRIER b{}; b.Type=D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b.Transition.pResource=tex.gpu.Get(); b.Transition.Subresource=D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        b.Transition.StateBefore=tex.state; b.Transition.StateAfter=state;
+        commands->ResourceBarrier(1,&b); tex.state=state;
+    }
+    Texture texture(uint32_t w,uint32_t h,DXGI_FORMAT format,uint32_t channels,bool uav)
+    {
+        Texture t; t.width=w; t.height=h; t.channels=channels;
+        D3D12_HEAP_PROPERTIES hp{};hp.Type=D3D12_HEAP_TYPE_DEFAULT;
+        D3D12_RESOURCE_DESC desc{};desc.Dimension=D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+        desc.Width=w;desc.Height=h;desc.DepthOrArraySize=1;desc.MipLevels=1;desc.Format=format;
+        desc.SampleDesc.Count=1;desc.Flags=uav?D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS:D3D12_RESOURCE_FLAG_NONE;
+        check(device->CreateCommittedResource(&hp,D3D12_HEAP_FLAG_NONE,&desc,t.state,nullptr,IID_PPV_ARGS(&t.gpu)),"Create texture");
+        device->GetCopyableFootprints(&desc,0,1,0,&t.footprint,nullptr,nullptr,&t.bytes);
+        t.upload=buffer(t.bytes,D3D12_HEAP_TYPE_UPLOAD,D3D12_RESOURCE_STATE_GENERIC_READ);
+        if(uav) t.readback=buffer(t.bytes,D3D12_HEAP_TYPE_READBACK,D3D12_RESOURCE_STATE_COPY_DEST);
+        return t;
+    }
+    void uploadTexture(Texture& tex,const float* source)
+    {
+        void* mapped=nullptr; D3D12_RANGE empty{0,0};check(tex.upload->Map(0,&empty,&mapped),"Map frame upload");
+        const size_t row=static_cast<size_t>(tex.width)*tex.channels*sizeof(float);
+        for(uint32_t y=0;y<tex.height;y++)
+            std::memcpy(static_cast<char*>(mapped)+tex.footprint.Offset+static_cast<size_t>(y)*tex.footprint.Footprint.RowPitch,
+                        source+static_cast<size_t>(y)*tex.width*tex.channels,row);
+        tex.upload->Unmap(0,nullptr);
+        transition(tex,D3D12_RESOURCE_STATE_COPY_DEST);
+        D3D12_TEXTURE_COPY_LOCATION dst{};dst.pResource=tex.gpu.Get();dst.Type=D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        D3D12_TEXTURE_COPY_LOCATION src{};src.pResource=tex.upload.Get();src.Type=D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;src.PlacedFootprint=tex.footprint;
+        commands->CopyTextureRegion(&dst,0,0,0,&src,nullptr);
+        transition(tex,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    }
+    void copyResult(Texture& tex)
+    {
+        transition(tex,D3D12_RESOURCE_STATE_COPY_SOURCE);
+        D3D12_TEXTURE_COPY_LOCATION dst{};dst.pResource=tex.readback.Get();dst.Type=D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;dst.PlacedFootprint=tex.footprint;
+        D3D12_TEXTURE_COPY_LOCATION src{};src.pResource=tex.gpu.Get();src.Type=D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        commands->CopyTextureRegion(&dst,0,0,0,&src,nullptr);
+    }
+    void download(Texture& tex,float* output)
+    {
+        void* p=nullptr;D3D12_RANGE range{0,static_cast<SIZE_T>(tex.bytes)};
+        check(tex.readback->Map(0,&range,&p),"Map result");
+        size_t row=static_cast<size_t>(tex.width)*tex.channels*sizeof(float);
+        for(uint32_t y=0;y<tex.height;y++)
+            std::memcpy(output+static_cast<size_t>(y)*tex.width*tex.channels,
+                        static_cast<char*>(p)+tex.footprint.Offset+static_cast<size_t>(y)*tex.footprint.Footprint.RowPitch,row);
+        D3D12_RANGE empty{0,0};tex.readback->Unmap(0,&empty);
+    }
+    void initialize()
+    {
+        wchar_t path[32768]{};
+        HMODULE self=GetModuleHandleW(L"KombatantRTX64.dll");
+        if(!self || !GetModuleFileNameW(self,path,32768)) throw std::runtime_error("Cannot locate RTX module");
+        modulePath=std::filesystem::path(path).parent_path();
+        ComPtr<IDXGIFactory6> factory;check(CreateDXGIFactory2(0,IID_PPV_ARGS(&factory)),"Create DXGI factory");
+        for(UINT i=0;;i++)
+        {
+            ComPtr<IDXGIAdapter1> adapter;
+            const HRESULT enumerated=factory->EnumAdapterByGpuPreference(i,DXGI_GPU_PREFERENCE_HIGH_PERFORMANCE,IID_PPV_ARGS(&adapter));
+            if(enumerated==DXGI_ERROR_NOT_FOUND) break;
+            check(enumerated,"Enumerate adapter");
+            DXGI_ADAPTER_DESC1 desc{};adapter->GetDesc1(&desc);
+            if(desc.VendorId!=0x10de || (desc.Flags&DXGI_ADAPTER_FLAG_SOFTWARE)) continue;
+            if(SUCCEEDED(D3D12CreateDevice(adapter.Get(),D3D_FEATURE_LEVEL_12_0,IID_PPV_ARGS(&device))))
+            { std::wstring n(desc.Description);adapterName.assign(n.begin(),n.end());break; }
+        }
+        if(!device) throw std::runtime_error("No NVIDIA D3D12 adapter found");
+        D3D12_COMMAND_QUEUE_DESC q{};q.Type=D3D12_COMMAND_LIST_TYPE_DIRECT;
+        check(device->CreateCommandQueue(&q,IID_PPV_ARGS(&queue)),"Create queue");
+        check(device->CreateCommandAllocator(q.Type,IID_PPV_ARGS(&allocator)),"Create allocator");
+        check(device->CreateCommandList(0,q.Type,allocator.Get(),nullptr,IID_PPV_ARGS(&commands)),"Create command list");
+        check(commands->Close(),"Close initial list");
+        check(device->CreateFence(0,D3D12_FENCE_FLAG_NONE,IID_PPV_ARGS(&fence)),"Create fence");
+        eventHandle=CreateEventW(nullptr,FALSE,FALSE,nullptr);
+        if(!eventHandle) throw std::runtime_error("Cannot create GPU fence event");
+        // DLSS and DXR capabilities are independent; one failure does not block the other.
+        try
+        {
