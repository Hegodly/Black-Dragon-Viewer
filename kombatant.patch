+        }
+    };
+    inline void flipRows(std::vector<float>& data,U32 w,U32 h,U32 channels)
+    {
+        size_t stride=size_t(w)*channels;
+        for(U32 y=0;y<h/2;y++)
+            std::swap_ranges(data.begin()+size_t(y)*stride,data.begin()+size_t(y+1)*stride,data.begin()+size_t(h-1-y)*stride);
+    }
+    inline void read(GLuint texture,GLenum format,U32 w,U32 h,U32 channels,std::vector<float>& data)
+    {
+        data.resize(size_t(w)*h*channels);
+        gGL.getTexUnit(0)->bindManual(LLTexUnit::TT_TEXTURE,texture);
+        glGetTexImage(GL_TEXTURE_2D,0,format,GL_FLOAT,data.data());
+        flipRows(data,w,h,channels);
+    }
+    inline void collectGeometry(const glm::vec3& camera)
+    {
+        geometry.clear();constexpr size_t maxFloats=600000*3;
+        for(S32 i=0;i<gObjectList.getNumObjects() && geometry.size()+9<=maxFloats;i++)
+        {
+            LLViewerObject* object=gObjectList.getObject(i);
+            if(!object || object->isDead() || object->getPCode()!=LL_PCODE_VOLUME || object->isHUDAttachment() ||
+               object->isAttachment() || object->isRiggedMesh() || object->isFlexible() || object->mDrawable.isNull()) continue;
+            auto* volume=object->getVolume();if(!volume) continue;
+            LLVector3 center=object->getRenderPosition();
+            glm::vec3 delta(center.mV[0]-camera.x,center.mV[1]-camera.y,center.mV[2]-camera.z);
+            if(glm::dot(delta,delta)>64.f*64.f) continue;
+            const LLVector3 scale=object->getScale();const LLQuaternion rotation=object->getRenderRotation();
+            for(S32 face=0;face<volume->getNumVolumeFaces() && geometry.size()+9<=maxFloats;face++)
+            {
+                if(face>=object->mDrawable->getNumFaces()) continue;
+                if(face<object->getNumTEs() && object->getTE((U8)face)->getColor().mV[3]<0.99f) continue;
+                LLFace* renderFace=object->mDrawable->getFace(face);if(!renderFace) continue;
+                U32 pool=renderFace->getPoolType();
+                if(pool==LLDrawPool::POOL_ALPHA || pool==LLDrawPool::POOL_ALPHA_PRE_WATER ||
+                   pool==LLDrawPool::POOL_ALPHA_POST_WATER || pool==LLDrawPool::POOL_ALPHA_MASK ||
+                   pool==LLDrawPool::POOL_FULLBRIGHT_ALPHA_MASK || pool==LLDrawPool::POOL_GLTF_PBR_ALPHA_MASK) continue;
+                const LLVolumeFace& vf=volume->getVolumeFace(face);
+                if(!vf.mPositions || !vf.mIndices) continue;
+                for(S32 k=0;k+2<vf.mNumIndices && geometry.size()+9<=maxFloats;k+=3)
+                {
+                    float triangle[9];bool valid=true;
+                    for(S32 j=0;j<3;j++)
+                    {
+                        const U16 index=vf.mIndices[k+j];if(index>=vf.mNumVertices) {valid=false;break;}
+                        const F32* v=vf.mPositions[index].getF32ptr();
+                        LLVector3 p(v[0],v[1],v[2]);p.scaleVec(scale);p=p*rotation+center;
+                        for(S32 axis=0;axis<3;axis++) {triangle[j*3+axis]=p.mV[axis];valid=valid&&std::isfinite(p.mV[axis]);}
+                    }
+                    if(valid) geometry.insert(geometry.end(),triangle,triangle+9);
+                }
+            }
+        }
