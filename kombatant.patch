diff --git a/indra/llwindow/kombatantfxwin32.h b/indra/llwindow/kombatantfxwin32.h
new file mode 100644
index 0000000..d52b23f
--- /dev/null
+++ b/indra/llwindow/kombatantfxwin32.h
@@ -0,0 +1,98 @@
+// Copyright (C) 2026 Kombatant Viewer contributors
+// SPDX-License-Identifier: LGPL-2.1-only
+#pragma once
+
+// SDK and runtime are built from the same pinned ReShade revision.
+#include "../third_party/reshade/include/reshade.hpp"
+#include <filesystem>
+
+namespace KombatantFX
+{
+    inline HMODULE module = nullptr;
+    inline HWND window = nullptr;
+    inline reshade::api::effect_runtime* runtime = nullptr;
+    inline std::string status = "Shader runtime has not initialized.";
+    inline bool attempted = false;
+
+    inline void onPresent(reshade::api::effect_runtime* effect)
+    {
+        if (effect->get_hwnd() == window)
+        {
+            if (runtime != effect)
+            {
+                runtime = effect;
+                runtime->set_effects_state(false);
+                status = "ReShade ready. Load a preset or open shader controls.";
+            }
+        }
+    }
+
+    inline void onDestroy(reshade::api::effect_runtime* effect)
+    {
+        if (runtime == effect)
+        {
+            runtime = nullptr;
+            status = "Waiting for the OpenGL context to restart.";
+        }
+    }
+
+    inline void initialize()
+    {
+        if (attempted) return;
+        attempted = true;
+        if (GetEnvironmentVariableW(L"KOMBATANT_DISABLE_FX", nullptr, 0))
+        {
+            status = "Shader runtime disabled by KOMBATANT_DISABLE_FX.";
+            return;
+        }
+        wchar_t executable[32768] = {};
+        const DWORD count = GetModuleFileNameW(nullptr, executable, 32768);
+        if (!count || count >= 32768) return;
+        const auto base = std::filesystem::path(executable).parent_path();
+        // Respect an existing external GShade/ReShade installation.
+        std::error_code ec;
+        if (std::filesystem::exists(base / L"opengl32.dll", ec))
+        {
+            status = "External opengl32.dll detected. Use its overlay, or remove it and restart to use built-in FX.";
+            return;
+        }
+        const auto library = base / L"KombatantFX64.dll";
+        module = LoadLibraryExW(library.c_str(), nullptr,
+            LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_SYSTEM32);
+        if (!module)
+        {
+            status = "KombatantFX64.dll could not load. Native effects remain available.";
+            return;
+        }
+        if (!reshade::register_addon(GetModuleHandleW(nullptr), module))
+        {
+            status = "Shader runtime API mismatch. Use the DLL shipped with this viewer.";
+            return;
+        }
+        reshade::register_event<reshade::addon_event::init_effect_runtime>(onPresent);
+        reshade::register_event<reshade::addon_event::reshade_present>(onPresent);
+        reshade::register_event<reshade::addon_event::destroy_effect_runtime>(onDestroy);
+        status = "Waiting for first OpenGL frame.";
+        // Keep the hooked DLL loaded until process exit. Never unload active GL hooks.
+    }
+
+    inline bool configure(bool enabled, const std::string& preset, bool overlay, bool reload)
+    {
+        if (!runtime) return false;
+        if (!preset.empty())
+        {
+            const auto path = std::filesystem::path(std::u8string(preset.begin(), preset.end()));
+            std::error_code ec;
+            if (path.extension() != L".ini" || !std::filesystem::is_regular_file(path, ec))
+            {
+                status = "Preset must be an existing .ini file.";
+                return false;
+            }
+            runtime->set_current_preset_path(preset.c_str());
+        }
+        runtime->set_effects_state(enabled);
+        if (reload) runtime->reload_effect_next_frame(nullptr);
+        if (overlay) runtime->open_overlay(true, reshade::api::input_source::mouse);
+        return true;
+    }
+}
