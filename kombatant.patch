@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+# Run from Git Bash with the VS 2022 x64 developer environment available.
+set -eo pipefail
+cd "$(dirname "$0")/.."
+if [[ "$OSTYPE" != msys* && "$OSTYPE" != cygwin* ]]; then
+    echo 'This build script requires Windows, Git Bash, and Visual Studio 2022.' >&2
+    exit 1
+fi
+command -v autobuild >/dev/null || { echo 'Install Python autobuild and llsd first.' >&2; exit 1; }
+command -v msbuild.exe >/dev/null || { echo 'Launch from the VS 2022 x64 developer environment.' >&2; exit 1; }
+export AUTOBUILD_ADDRSIZE=64
+export AUTOBUILD_VSVER=170
+export AUTOBUILD_WIN_CMAKE_GEN='Visual Studio 17 2022'
+export AUTOBUILD_WIN_VSPLATFORM=x64
+export AUTOBUILD_VARIABLES_FILE="$(pwd)/variables/variables"
+source variables/convenience Release
+export LL_BUILD
+# Build an unpackaged open-source configuration first; installer is a later gate.
+autobuild configure -A 64 -c ReleaseOS -- \
+    -DVIEWER_CHANNEL:STRING='Kombatant Viewer' \
+    -DINSTALL_PROPRIETARY:BOOL=OFF \
+    -DUSE_KDU:BOOL=OFF \
+    -DUSE_FMODSTUDIO:BOOL=OFF \
+    -DUSE_OPENAL:BOOL=ON \
+    -DBUGSPLAT_DB:STRING= \
+    -DPACKAGE:BOOL=OFF
+# Avoid packaging/signing until the viewer has passed runtime smoke tests.
+autobuild build -A 64 -c ReleaseOS
diff --git a/kombatant/fx/KombatantColor.fx b/kombatant/fx/KombatantColor.fx
new file mode 100644
index 0000000..8cb71c7
--- /dev/null
+++ b/kombatant/fx/KombatantColor.fx
@@ -0,0 +1,28 @@
+// Copyright (C) 2026 Kombatant Viewer contributors
+// SPDX-License-Identifier: MIT
+// Standalone sample; no external shader packs or textures required.
+uniform float Saturation < ui_type="slider"; ui_min=0.0; ui_max=2.0; > = 1.0;
+uniform float Contrast < ui_type="slider"; ui_min=0.5; ui_max=1.5; > = 1.0;
+uniform float Vignette < ui_type="slider"; ui_min=0.0; ui_max=1.0; > = 0.0;
+texture BackBuffer : COLOR;
+sampler BackBufferSampler { Texture = BackBuffer; };
+
+void FullscreenVS(uint id : SV_VertexID, out float4 position : SV_Position, out float2 uv : TEXCOORD)
+{
+    uv = float2((id << 1) & 2, id & 2);
+    position = float4(uv * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
+}
+float4 ColorPS(float4 position : SV_Position, float2 uv : TEXCOORD) : SV_Target
+{
+    float4 color = tex2D(BackBufferSampler, uv);
+    float luma = dot(color.rgb, float3(0.2126, 0.7152, 0.0722));
+    color.rgb = lerp(luma.xxx, color.rgb, Saturation);
+    color.rgb = (color.rgb - 0.5) * Contrast + 0.5;
+    float2 centered = uv * 2.0 - 1.0;
+    color.rgb *= 1.0 - Vignette * smoothstep(0.2, 1.4, dot(centered, centered));
+    return float4(saturate(color.rgb), color.a);
+}
+technique KombatantColor
+{
+    pass { VertexShader = FullscreenVS; PixelShader = ColorPS; }
+}
