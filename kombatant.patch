+    }
+};
+}
+extern "C" __declspec(dllexport) int KombatantRtxProcessFrame(KombatantRtxFrame* frame,char* diagnostic,uint32_t capacity)
+{
+    static std::mutex mutex;std::lock_guard<std::mutex> lock(mutex);
+    // Leak at exit by design: process teardown owns GPU/NGX shutdown ordering.
+    static Runtime* runtime=new Runtime;
+    std::string status;int result=0;
+    if(!KombatantRtxMath::validFrame(frame))
+        status="Invalid RTX frame, dimensions or ABI; experimental output limit is 4096 per axis";
+    else result=runtime->process(*frame,status);
+    if(diagnostic && capacity) {size_t n=std::min<size_t>(status.size(),capacity-1);std::memcpy(diagnostic,status.data(),n);diagnostic[n]=0;}
+    return result;
+}
diff --git a/kombatant/rtx/rtx_math.h b/kombatant/rtx/rtx_math.h
new file mode 100644
--- /dev/null
+++ b/kombatant/rtx/rtx_math.h
@@ -0,0 +1,28 @@
+// Copyright (C) 2026 Kombatant Viewer contributors
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "rtx_api.h"
+#include <cmath>
+namespace KombatantRtxMath {
+inline float halton(uint32_t index,uint32_t base)
+{
+    float fraction=1.f,value=0.f;
+    while(index) {fraction/=base;value+=fraction*(index%base);index/=base;}
+    return value;
+}
+inline void motionPixels(float currentMinusPreviousNdcX,float currentMinusPreviousNdcY,
+                         uint32_t width,uint32_t height,float jitterDeltaX,float jitterDeltaY,float& x,float& y)
+{
+    x=-currentMinusPreviousNdcX*width*0.5f-jitterDeltaX;
+    y= currentMinusPreviousNdcY*height*0.5f-jitterDeltaY;
+    if(!std::isfinite(x) || !std::isfinite(y)) x=y=0.f;
+}
+inline bool validFrame(const KombatantRtxFrame* f)
+{
+    return f && f->abi==KOMBATANT_RTX_ABI && f->bytes==sizeof(KombatantRtxFrame) &&
+        f->width>=16 && f->height>=16 && f->target_width>=f->width && f->target_height>=f->height &&
+        f->target_width<=4096 && f->target_height<=4096 && f->color && f->depth && f->motion && f->output &&
+        f->vertex_count<=600000 && f->vertex_count%3==0 && (!f->vertex_count || f->vertices) && f->dlss_mode<=3 &&
+        std::isfinite(f->ao_radius) && std::isfinite(f->ao_strength);
+}
+}
diff --git a/kombatant/rtx/rtx_math_test.cpp b/kombatant/rtx/rtx_math_test.cpp
new file mode 100644
--- /dev/null
+++ b/kombatant/rtx/rtx_math_test.cpp
@@ -0,0 +1,32 @@
+// Copyright (C) 2026 Kombatant Viewer contributors
+// SPDX-License-Identifier: MIT
+#include "rtx_math.h"
+#include <cassert>
+#include <limits>
+#include <cmath>
+int main()
+{
+    using namespace KombatantRtxMath;
+    float x=0,y=0;
+    // A +2 pixel rightward, +3 pixel upward current-frame displacement must reproject left/down.
+    motionPixels(4.f/1920.f,6.f/1080.f,1920,1080,0,0,x,y);
+    assert(std::abs(x+2)<1e-5f && std::abs(y-3)<1e-5f);
+    // A stationary surface rendered with a new jitter has no geometric motion.
+    const float jx=.25f,jy=-.125f;
+    motionPixels(-2*jx/1920,2*jy/1080,1920,1080,jx,jy,x,y);
+    assert(std::abs(x)<1e-5f && std::abs(y)<1e-5f);
+    motionPixels(std::numeric_limits<float>::quiet_NaN(),1,1920,1080,0,0,x,y);
+    assert(x==0 && y==0);
+    for(uint32_t i=1;i<=16;i++) {assert(halton(i,2)>=0 && halton(i,2)<1);assert(halton(i,3)>=0 && halton(i,3)<1);}
+    assert(halton(1,2)==.5f && halton(2,2)==.25f);
+    float dummy=0;KombatantRtxFrame frame{};
+    frame.abi=KOMBATANT_RTX_ABI;frame.bytes=sizeof(frame);frame.width=1280;frame.height=720;
+    frame.target_width=1920;frame.target_height=1080;frame.color=frame.depth=frame.motion=&dummy;frame.output=&dummy;
+    assert(validFrame(&frame));assert(!validFrame(nullptr));
+    frame.target_width=8192;assert(!validFrame(&frame));frame.target_width=1920;
+    frame.vertex_count=3;assert(!validFrame(&frame));frame.vertices=&dummy;assert(validFrame(&frame));
+    frame.vertex_count=4;assert(!validFrame(&frame));frame.vertex_count=600003;assert(!validFrame(&frame));frame.vertex_count=0;
+    frame.dlss_mode=4;assert(!validFrame(&frame));frame.dlss_mode=1;assert(validFrame(&frame));
+    frame.abi=0;assert(!validFrame(&frame));frame.abi=KOMBATANT_RTX_ABI;
+    frame.ao_radius=std::numeric_limits<float>::infinity();assert(!validFrame(&frame));
+}
diff --git a/kombatant/rtx/rtx_smoke_test.cpp b/kombatant/rtx/rtx_smoke_test.cpp
new file mode 100644
--- /dev/null
+++ b/kombatant/rtx/rtx_smoke_test.cpp
@@ -0,0 +1,28 @@
+// Copyright (C) 2026 Kombatant Viewer contributors
+// SPDX-License-Identifier: MIT
+#include "rtx_api.h"
+#include <windows.h>
+#include <cassert>
+#include <vector>
+#include <iostream>
+int wmain(int argc,wchar_t** argv)
+{
+    assert(argc==2);
+    auto module=LoadLibraryExW(argv[1],nullptr,LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR|LOAD_LIBRARY_SEARCH_SYSTEM32);
+    assert(module);
+    auto process=reinterpret_cast<KombatantRtxProcess>(GetProcAddress(module,"KombatantRtxProcessFrame"));assert(process);
+    char diagnostic[1024]{};
+    assert(process(nullptr,diagnostic,sizeof(diagnostic))==0 && diagnostic[0]);
+    KombatantRtxFrame frame{};assert(process(&frame,diagnostic,sizeof(diagnostic))==0);
+    std::vector<float> color(32*32*4,0.5f),depth(32*32,1.f),motion(32*32*2,0.f),output(64*64*4,0.f);
+    frame.abi=KOMBATANT_RTX_ABI;frame.bytes=sizeof(frame);frame.width=frame.height=32;
+    frame.target_width=frame.target_height=64;frame.dlss_mode=1;frame.reset=1;frame.frame_ms=16.6f;
+    frame.color=color.data();frame.depth=depth.data();frame.motion=motion.data();frame.output=output.data();
+    // Hosted CI has no NVIDIA GPU. A clean diagnostic/fallback is a supported result.
+    int result=process(&frame,diagnostic,sizeof(diagnostic));
+    assert(diagnostic[0]);
+    if(result) assert(frame.executed&1 && frame.output_width==64 && frame.output_height==64);
+    else assert(frame.executed==0);
+    std::cout<<diagnostic<<'\n';
+    // Module intentionally remains loaded until process exit, matching viewer lifetime.
+}
