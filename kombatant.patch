+        static_assert(sizeof(Constants)==96,"HLSL constant layout");
+        std::memcpy(constants.inverse,f.inverse_view_projection,64);constants.w=iw;constants.h=ih;
+        constants.radius=std::clamp(f.ao_radius,0.05f,10.f);constants.strength=std::clamp(f.ao_strength,0.f,1.f);constants.index=f.frame_index;
+        commands->SetComputeRoot32BitConstants(1,24,&constants,0);
+        commands->Dispatch((iw+7)/8,(ih+7)/8,1);barrier(rayColor.gpu.Get());
+    }
+    void configure(const KombatantRtxFrame& f)
+    {
+        if(iw==f.width && ih==f.height && ow==f.target_width && oh==f.target_height && mode==f.dlss_mode) return;
+        if(dlss) { NVSDK_NGX_D3D12_ReleaseFeature(dlss);dlss=nullptr; }
+        iw=f.width;ih=f.height;ow=f.target_width;oh=f.target_height;mode=f.dlss_mode;
+        color=texture(iw,ih,DXGI_FORMAT_R32G32B32A32_FLOAT,4,false);
+        depth=texture(iw,ih,DXGI_FORMAT_R32_FLOAT,1,false);
+        motion=texture(iw,ih,DXGI_FORMAT_R32G32_FLOAT,2,false);
+        rayColor=texture(iw,ih,DXGI_FORMAT_R32G32B32A32_FLOAT,4,true);
+        upscaled=texture(ow,oh,DXGI_FORMAT_R32G32B32A32_FLOAT,4,true);
+        if(!mode || !dlssAvailable) return;
+        begin();
+        NVSDK_NGX_DLSS_Create_Params params{};
+        params.Feature.InWidth=iw;params.Feature.InHeight=ih;params.Feature.InTargetWidth=ow;params.Feature.InTargetHeight=oh;
+        params.Feature.InPerfQualityValue=mode==3?NVSDK_NGX_PerfQuality_Value_MaxPerf:mode==2?NVSDK_NGX_PerfQuality_Value_Balanced:NVSDK_NGX_PerfQuality_Value_MaxQuality;
+        params.InFeatureCreateFlags=NVSDK_NGX_DLSS_Feature_Flags_MVLowRes;
+        const auto result=NGX_D3D12_CREATE_DLSS_EXT(commands.Get(),1,1,&dlss,parameters,&params);
+        submit();
+        if(NVSDK_NGX_FAILED(result)) {dlss=nullptr;dlssAvailable=false;std::ostringstream s;s<<"DLSS create failed: NGX 0x"<<std::hex<<uint32_t(result);dlssDiagnostic=s.str();}
+    }
+public:
+    // Runtime intentionally lives until process exit. GPU resources are never unloaded mid-command.
+    int process(KombatantRtxFrame& f,std::string& status)
+    {
+        if(dead) {status="RTX backend stopped after an error; restart to retry";return 0;}
+        try
+        {
+            if(!initialized) initialize();
+            configure(f);begin();
+            uploadTexture(color,f.color);uploadTexture(depth,f.depth);uploadTexture(motion,f.motion);
+            Texture* result=nullptr;Texture* input=&color;f.executed=0;
+            if(f.ray_ao && rayAvailable)
+            {
+                buildGeometry(f);
+                if(tlas) { trace(f);input=&rayColor;result=&rayColor;f.executed|=2;transition(rayColor,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE); }
+            }
+            if(f.dlss_mode && dlss)
+            {
+                transition(upscaled,D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+                NVSDK_NGX_D3D12_DLSS_Eval_Params params{};
+                params.Feature.pInColor=input->gpu.Get();params.Feature.pInOutput=upscaled.gpu.Get();
+                params.pInDepth=depth.gpu.Get();params.pInMotionVectors=motion.gpu.Get();
+                params.InJitterOffsetX=f.jitter_x;params.InJitterOffsetY=f.jitter_y;
+                params.InRenderSubrectDimensions={iw,ih};params.InReset=f.reset?1:0;
+                params.InMVScaleX=1.f;params.InMVScaleY=1.f;params.InPreExposure=1.f;params.InExposureScale=1.f;
+                params.InFrameTimeDeltaInMsec=std::clamp(f.frame_ms,1.f,1000.f);
+                auto evaluated=NGX_D3D12_EVALUATE_DLSS_EXT(commands.Get(),dlss,parameters,&params);
+                if(NVSDK_NGX_SUCCEED(evaluated)) { result=&upscaled;f.executed|=1;barrier(upscaled.gpu.Get()); }
+                else {std::ostringstream s;s<<"DLSS evaluate failed: NGX 0x"<<std::hex<<uint32_t(evaluated);dlssDiagnostic=s.str();}
+            }
+            if(result) copyResult(*result);
