+    }
+    inline LLRenderTarget* render(LLRenderTarget* source,LLRenderTarget* depthTarget,LLRenderTarget* motionTarget)
+    {
+        const U32 mode=gSavedSettings.getU32("KombatantDLSSMode");
+        const bool ray=gSavedSettings.getBOOL("KombatantRayAO");
+        if(!mode && !ray) {hadDLSS=false;return source;}
+        if(!initialize()) {gSavedSettings.setU32("KombatantDLSSMode",0);gSavedSettings.setBOOL("KombatantRayAO",false);return source;}
+        const U32 w=source->getWidth(),h=source->getHeight();
+        const U32 targetW=mode?gViewerWindow->getWorldViewWidthRaw():w;
+        const U32 targetH=mode?gViewerWindow->getWorldViewHeightRaw():h;
+        if(w<16 || h<16 || targetW<w || targetH<h || targetW>4096 || targetH>4096)
+        {status("Experimental RTX requires output up to 4096 pixels per axis");gSavedSettings.setU32("KombatantDLSSMode",0);gSavedSettings.setBOOL("KombatantRayAO",false);return source;}
+        if(!depthTarget->getDepth() || (mode && (!motionTarget->getTexture() || motionTarget->getWidth()!=w || motionTarget->getHeight()!=h)))
+        {status("RTX waiting for depth/motion buffers");return source;}
+        try
+        {
+            auto now=std::chrono::steady_clock::now();
+            glm::mat4 view=glm::make_mat4(gGLModelView),projection=glm::make_mat4(gGLProjection);
+            glm::mat4 vp=projection*view, inv=glm::inverse(vp),invView=glm::inverse(view);
+            glm::vec3 camera(invView[3]);
+            glm::vec3 forward=glm::normalize(glm::vec3(invView[2]));
+            const F32 jx=mode?KombatantRTXState::jitterX():0.f, jy=mode?-KombatantRTXState::jitterY():0.f;
+            bool reset=!previousWidth || (mode && !hadDLSS) || mode!=previousMode || w!=previousWidth || h!=previousHeight ||
+                std::chrono::duration<float>(now-lastFrame).count()>3.f || glm::distance(camera,previousCamera)>5.f || (previousWidth && glm::dot(forward,previousForward)<0.5f);
+            if(reset) {previousVP=vp;previousJitterX=jx;previousJitterY=jy;}
+            if(ray && (reset || std::chrono::duration<float>(now-lastGeometry).count()>0.5f))
+            {collectGeometry(camera);lastGeometry=now;}
+            PixelTransferState transfer;
+            read(source->getTexture(),GL_RGBA,w,h,4,colors);
+            read(depthTarget->getDepth(),GL_DEPTH_COMPONENT,w,h,1,depths);
+            if(mode) read(motionTarget->getTexture(),GL_RG,w,h,2,velocities);
+            else velocities.assign(size_t(w)*h*2,0.f);
+            if(mode)
+            {
+                for(U32 y=0;y<h;y++) for(U32 x=0;x<w;x++)
+                {
+                    size_t i=size_t(y)*w+x;float vx=velocities[i*2],vy=velocities[i*2+1];
+                    if(reset) {vx=vy=0.f;}
+                    else if(std::abs(vx)+std::abs(vy)<1e-7f)
+                    {
+                        // Camera reprojection fills geometry not covered by the velocity passes.
+                        glm::vec4 world=inv*glm::vec4((x+0.5f)*2.f/w-1.f,1.f-(y+0.5f)*2.f/h,depths[i]*2.f-1.f,1.f);
+                        glm::vec4 last=previousVP*world;
+                        if(std::abs(last.w)>1e-6f)
+                        {vx=(x+0.5f)*2.f/w-1.f-last.x/last.w;vy=1.f-(y+0.5f)*2.f/h-last.y/last.w;}
+                    }
+                    // GL velocity is current-minus-previous NDC; NGX expects previous-minus-current pixels, y down.
+                    if(reset) velocities[i*2]=velocities[i*2+1]=0.f;
+                    else KombatantRtxMath::motionPixels(vx,vy,w,h,jx-previousJitterX,jy-previousJitterY,velocities[i*2],velocities[i*2+1]);
+                }
+            }
+            pixels.resize(size_t(targetW)*targetH*4);
+            KombatantRtxFrame frame{};frame.abi=KOMBATANT_RTX_ABI;frame.bytes=sizeof(frame);
+            frame.width=w;frame.height=h;frame.target_width=targetW;frame.target_height=targetH;
+            frame.dlss_mode=mode;frame.ray_ao=ray;frame.reset=reset;frame.frame_index=KombatantRTXState::frameIndex;
+            frame.jitter_x=jx;frame.jitter_y=jy;frame.frame_ms=gFrameIntervalSeconds.value()*1000.f;
+            frame.ao_radius=gSavedSettings.getF32("KombatantRayAORadius");frame.ao_strength=gSavedSettings.getF32("KombatantRayAOStrength");
+            std::memcpy(frame.inverse_view_projection,glm::value_ptr(inv),64);
+            frame.color=colors.data();frame.depth=depths.data();frame.motion=velocities.data();frame.output=pixels.data();
+            frame.vertices=geometry.data();frame.vertex_count=static_cast<U32>(geometry.size()/3);frame.geometry_revision=geometryRevision;
