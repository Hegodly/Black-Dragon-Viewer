+// Copyright (C) 2026 Kombatant Viewer contributors
+// SPDX-License-Identifier: LGPL-2.1-only
+#pragma once
+#include "llviewercontrol.h"
+#include "../../kombatant/rtx/rtx_math.h"
+namespace KombatantRTXState
+{
+    inline U32 frameIndex=0;
+    inline bool wantsDLSS()
+    {
+#if LL_WINDOWS
+        return gSavedSettings.getU32("KombatantDLSSMode")!=0;
+#else
+        return false;
+#endif
+    }
+    inline F32 jitterX() {return KombatantRtxMath::halton(frameIndex%16+1,2)-0.5f;}
+    inline F32 jitterY() {return KombatantRtxMath::halton(frameIndex%16+1,3)-0.5f;}
+}
diff --git a/kombatant/build-rtx.ps1 b/kombatant/build-rtx.ps1
new file mode 100644
--- /dev/null
+++ b/kombatant/build-rtx.ps1
@@ -0,0 +1,50 @@
+# Build the experimental, isolated D3D12/NGX module and preserve vendor licenses.
+param([switch]$StageOnly)
+$ErrorActionPreference = 'Stop'
+$root = Split-Path -Parent $PSScriptRoot
+$install = Join-Path $root '.rtx-install'
+if (-not $StageOnly) {
+    $sdk = Join-Path $root '.dlss-sdk'
+    if (-not (Test-Path "$sdk/.git")) {
+        git clone --filter=blob:none --no-checkout https://github.com/NVIDIA/DLSS.git $sdk
+        if ($LASTEXITCODE) { throw 'DLSS SDK clone failed' }
+        git -C $sdk sparse-checkout set --no-cone '/include/' '/lib/Windows_x86_64/x64/nvsdk_ngx_s.lib' '/lib/Windows_x86_64/rel/nvngx_dlss.dll' '/LICENSE.txt'
+        if ($LASTEXITCODE) { throw 'DLSS sparse checkout failed' }
+    }
+    git -C $sdk checkout --detach 9981c6350dc58c0ce21f024fd65e31e851c31689
+    if ($LASTEXITCODE) { throw 'DLSS pinned checkout failed' }
+    $revision = (git -C $sdk rev-parse HEAD).Trim()
+    if ($revision -ne '9981c6350dc58c0ce21f024fd65e31e851c31689') { throw 'DLSS SDK revision mismatch' }
+    $runtime = "$sdk/lib/Windows_x86_64/rel/nvngx_dlss.dll"
+    if ((Get-FileHash $runtime -Algorithm SHA256).Hash.ToLowerInvariant() -ne 'd00b5b0ab29c3ca101b70c3a5ecb3a01b7ef33766a3383a28a18623083e6123e') { throw 'NVIDIA runtime hash mismatch' }
+    $signature = Get-AuthenticodeSignature $runtime
+    if ($signature.Status -ne 'Valid' -or $signature.SignerCertificate.Subject -notmatch 'NVIDIA') { throw 'NVIDIA runtime signature invalid' }
+    $dxc = Join-Path $root '.dxc'
+    if (-not (Test-Path "$dxc/bin/x64/dxc.exe")) {
+        $zip = Join-Path $root '.dxc.zip'
+        Invoke-WebRequest 'https://github.com/microsoft/DirectXShaderCompiler/releases/download/v1.8.2505.1/dxc_2025_07_14.zip' -OutFile $zip
+        if ((Get-FileHash $zip -Algorithm SHA256).Hash.ToLowerInvariant() -ne '9ad895a6b039e3a8f8c22a1009f866800b840a74b50db9218d13319e215ea8a4') { throw 'DXC archive hash mismatch' }
+        Expand-Archive -Path $zip -DestinationPath $dxc -Force
+    }
+    cmake -S "$PSScriptRoot/rtx" -B "$root/.rtx-build" -G 'Visual Studio 17 2022' -A x64 "-DNGX_ROOT=$sdk" "-DDXC_EXECUTABLE=$dxc/bin/x64/dxc.exe" "-DCMAKE_INSTALL_PREFIX=$install"
+    if ($LASTEXITCODE) { throw 'RTX configuration failed' }
+    cmake --build "$root/.rtx-build" --config Release --parallel 2
+    if ($LASTEXITCODE) { throw 'RTX module compilation failed' }
+    ctest --test-dir "$root/.rtx-build" -C Release --output-on-failure
+    if ($LASTEXITCODE) { throw 'RTX CPU contract tests failed' }
+    cmake --install "$root/.rtx-build" --config Release
+    if ($LASTEXITCODE) { throw 'RTX install failed' }
+}
+if ($StageOnly) {
+    $stage = Join-Path $root 'build-vc170-64/newview/Release'
+    if (-not (Test-Path "$stage/blackdragon-bin.exe")) { throw 'Viewer stage missing' }
+    foreach ($file in @('KombatantRTX64.dll', 'kombatant_rtao.dxil', 'nvngx_dlss.dll')) {
+        if (-not (Test-Path "$install/$file")) { throw "Missing RTX build file: $file" }
+        Copy-Item "$install/$file" $stage -Force
+    }
+    New-Item -ItemType Directory -Force "$stage/licenses" | Out-Null
+    Copy-Item "$install/licenses/NVIDIA-DLSS-LICENSE.txt" "$stage/licenses" -Force
+    Copy-Item "$PSScriptRoot/rtx/LICENSE.txt" "$stage/licenses/Kombatant-RTX-LICENSE.txt" -Force
+    Copy-Item "$PSScriptRoot/rtx/RTX-TESTING.md" "$stage/RTX-TESTING.md" -Force
+    Copy-Item "$PSScriptRoot/rtx/Start-Without-RTX.cmd" $stage -Force
+}
