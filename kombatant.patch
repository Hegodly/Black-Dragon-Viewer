+            std::ostringstream s;s<<adapterName<<" | ";
+            s<<(f.executed&1?"DLSS running":dlssDiagnostic)<<" | ";
+            s<<(f.executed&2?"Hardware DXR AO running":f.ray_ao&&rayAvailable?"DXR ready; no eligible world geometry":rayDiagnostic);
